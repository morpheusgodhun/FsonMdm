@{
    var authed = User?.Identity?.IsAuthenticated == true;
    var current = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "FSON MDM") · FSON MDM</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (authed)
    {
        <header class="topbar">
            <div class="brand">
                <span class="brand-mark">FSON</span>
                <span class="brand-sub">MDM Yönetim Paneli</span>
            </div>
            <nav class="topnav">
                <a class="@(current == "Index" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Cihazlar</a>
                <a class="@(current == "Policy" ? "active" : "")" asp-controller="Dashboard" asp-action="Policy">Politika &amp; Kiosk</a>
                <a class="@(current == "Apps" ? "active" : "")" asp-controller="Dashboard" asp-action="Apps">Uygulamalar (APK)</a>
            </nav>
            <div class="topbar-right">
                <span class="who">@User.Identity?.Name</span>
                <a class="btn btn-ghost" asp-controller="Dashboard" asp-action="Logout">Çıkış</a>
            </div>
        </header>
    }
    <main class="container">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
